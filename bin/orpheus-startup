#!/usr/bin/env bash
# orpheus-startup-v2 — ORPHEUS session initialization protocol (isolated + telemetry)
# Each step runs independently. Failures are recorded but do not block downstream steps.
# Timing and exit codes are emitted as structured JSON for downstream digest/summary use.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ORPHEUS_HOME="${ORPHEUS_HOME:-${HOME}/.config/orpheus}"
BIN_DIR="${ORPHEUS_HOME}/workspaces/4225ca70-bc89-46be-99ef-d3e82098faf2/bin"

# Fallback: if scripts are not in expected workspace path, use SCRIPT_DIR
[ -f "$BIN_DIR/health-check" ] || BIN_DIR="$SCRIPT_DIR"

# Where to write structured session state for digest/auditing
STATE_DIR="${ORPHEUS_HOME}/.state"
mkdir -p "$STATE_DIR"
SESSION_FILE="$STATE_DIR/startup-$(date -u +%Y%m%d-%H%M%S).json"

# Result accumulator (name|duration_ms|exit_code|category)
declare -a RESULTS
declare -i TOTAL_STEPS=0

run_step() {
    local name="$1"
    local cmd="$2"
    local category="${3:-general}"

    local t_start t_end duration_ms exit_code step_output
    t_start=$(date +%s%N 2>/dev/null || date +%s)

    # Capture output to a temp file for potential extraction
    local tmpfile
    tmpfile=$(mktemp)
    (eval "$cmd") >"$tmpfile" 2>&1
    exit_code=$?

    t_end=$(date +%s%N 2>/dev/null || date +%s)
    if command -v bc &>/dev/null && [ "$t_start" != "$t_end" ]; then
        duration_ms=$(echo "scale=3; ($t_end - $t_start) / 1000000" | bc)
    else
        duration_ms=$(( (t_end - t_start) * 1000 ))
    fi

    RESULTS[$TOTAL_STEPS]="$name|$duration_ms|$exit_code|$category"
    ((TOTAL_STEPS++))

    # Print step header + concise status
    local status_icon="✅"
    local status_text="PASS"
    if [ "$exit_code" -ne 0 ]; then
        status_icon="❌"
        status_text="FAIL (exit $exit_code)"
    fi

    echo "== $name [$status_text, ${duration_ms}ms] =="
    # Print first 20 lines of output for visibility
    head -n 20 "$tmpfile"
    local line_count
    line_count=$(wc -l < "$tmpfile")
    if [ "$line_count" -gt 20 ]; then
        echo "  ... ($((line_count - 20)) more lines truncated)"
    fi
    echo ""

    rm -f "$tmpfile"
    return 0  # Always return 0 so downstream steps run
}

# ── JSON State Emitter (function scope allows local vars) ───────────
emit_state_json() {
    local outfile="$1"
    local i
    local comma=""
    {
        echo "{"
        echo '  "timestamp": "'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'",'
        echo '  "session_dir": "'"$PWD"'",'
        echo '  "steps": ['
        for ((i=0; i<TOTAL_STEPS; i++)); do
            local name dur rc cat
            name=$(echo "${RESULTS[$i]}" | cut -d'|' -f1)
            dur=$(echo "${RESULTS[$i]}" | cut -d'|' -f2)
            rc=$(echo "${RESULTS[$i]}" | cut -d'|' -f3)
            cat=$(echo "${RESULTS[$i]}" | cut -d'|' -f4)
            echo '    '"$comma"'{"name": "'"$name"'", "duration_ms": '"$dur"', "exit_code": '"$rc"', "category": "'"$cat"'"}'
            comma=","
        done
        echo '  ]'
        echo "}"
    } > "$outfile"
}

# ── Summary Printer (function scope allows local vars) ──────────────
emit_summary() {
    local total_duration=0
    local errors=0
    local warnings=0
    local j
    echo "== Startup Summary =="
    for ((j=0; j<TOTAL_STEPS; j++)); do
        local name dur rc cat icon dur_warn
        name=$(echo "${RESULTS[$j]}" | cut -d'|' -f1)
        dur=$(echo "${RESULTS[$j]}" | cut -d'|' -f2)
        rc=$(echo "${RESULTS[$j]}" | cut -d'|' -f3)
        cat=$(echo "${RESULTS[$j]}" | cut -d'|' -f4)

        if [ "$rc" -ne 0 ]; then
            icon="❌"
            ((errors++))
        else
            icon="✅"
        fi

        # Warn if step took > 5s
        dur_warn=""
        if command -v python3 &>/dev/null; then
            if python3 -c "import sys; exit(0 if float(sys.argv[1]) < 5000 else 1)" "$dur" &>/dev/null; then
                true
            else
                dur_warn=" ⚠️ SLOW"
                ((warnings++))
            fi
        fi

        printf "  %-40s %s %6sms%s\n" "$name" "$icon" "$dur" "$dur_warn"
        total_duration=$(echo "$total_duration + $dur" | bc 2>/dev/null || echo "$((total_duration + dur))")
    done

    echo ""
    if [ "$errors" -gt 0 ]; then
        echo "STATUS: READY WITH $errors FAILURE(S)"
        echo "  Downstream steps ran independently. Check steps marked ❌ above."
    elif [ "$warnings" -gt 0 ]; then
        echo "STATUS: READY WITH $warnings NON-CRITICAL NOTE(S)"
    else
        echo "STATUS: FULLY OPERATIONAL"
    fi
    echo "Total time: ${total_duration}ms"
    echo "Session state: $SESSION_FILE"
    echo ""
    echo "All steps complete. Ready to work."
}

# ═══════════════════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════════════════

echo "== ORPHEUS Startup Protocol v2 =="
echo "Timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "State file: $SESSION_FILE"
echo ""

# ── Step 1: Dependency health audit ────────────────────────────────
run_step "Dependency Health Check" "\"$BIN_DIR/health-check\"" "infra"

# ── Step 2: Capability scan (auto-discover new tools) ──────────────
run_step "Capability Discovery" "\"$BIN_DIR/capability-scan\" scan" "infra"

# ── Step 3: Git pre-flight (only if inside a repo) ─────────────────
PREFLIGHT_EXIT=0
if git rev-parse --git-dir &>/dev/null; then
    run_step "Git Pre-flight" "\"$BIN_DIR/preflight-git\"" "git"
    PREFLIGHT_EXIT=$(echo "${RESULTS[$((TOTAL_STEPS-1))]}" | cut -d'|' -f3)

    # ── Step 4: Project auto-detection and context loading ─────────
    if [ -f "$BIN_DIR/project-registry" ]; then
        current_dir="$(pwd)"
        run_step "Project Registry Load" "\"$BIN_DIR/project-registry\" load \"$current_dir\"" "project"
        load_exit=$(echo "${RESULTS[$((TOTAL_STEPS-1))]}" | cut -d'|' -f3)
        if [ "$load_exit" -ne 0 ]; then
            echo "  [INFO] Project not in registry — auto-detecting..."
            run_step "Project Registry Detect" "\"$BIN_DIR/project-registry\" detect \"$current_dir\"" "project"
            echo ""
            run_step "Project Registry Load (retry)" "\"$BIN_DIR/project-registry\" load \"$current_dir\"" "project"
        fi
    fi

    # ── Step 5: Diff review summary (if uncommitted changes) ───────
    if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
        run_step "Uncommitted Changes" "git diff --stat && git diff --cached --stat" "git"
    else
        RESULTS[$TOTAL_STEPS]="Uncommitted Changes|0|0|git"
        ((TOTAL_STEPS++))
        echo "== Uncommitted Changes [SKIP, no changes] =="
        echo ""
    fi
else
    RESULTS[$TOTAL_STEPS]="Git Pre-flight|0|0|git"
    ((TOTAL_STEPS++))
    echo "== Git Pre-flight [SKIP, not in repo] =="
    echo ""
fi

# ── Step 6: Task Orchestration — drift detection ───────────────────
if [ -f "$BIN_DIR/task-orchestrator" ]; then
    run_step "Task Orchestrator" "\"$BIN_DIR/task-orchestrator\" drift" "tasks"
else
    RESULTS[$TOTAL_STEPS]="Task Orchestrator|0|0|tasks"
    ((TOTAL_STEPS++))
fi

# ── Step 7: Security quick-scan (lightweight, cached) ──────────────
SECURITY_LAST="${ORPHEUS_HOME}/.last-security-scan"
if [ ! -f "$SECURITY_LAST" ] || [ -n "$(find "$SECURITY_LAST" -mtime +1 2>/dev/null)" ]; then
    run_step "Quick Security Scan" "\"$BIN_DIR/security-scan\"" "security"
    touch "$SECURITY_LAST" 2>/dev/null || true
else
    RESULTS[$TOTAL_STEPS]="Quick Security Scan|0|0|security"
    ((TOTAL_STEPS++))
    echo "== Quick Security Scan [SKIP, ran within 24h] =="
    echo ""
fi

# ── Step 8: Proactive suggestion engine ────────────────────────────
if [ -f "$BIN_DIR/suggest-next" ]; then
    run_step "Proactive Suggestions" "\"$BIN_DIR/suggest-next\" --quiet" "suggestions"
else
    RESULTS[$TOTAL_STEPS]="Proactive Suggestions|0|0|suggestions"
    ((TOTAL_STEPS++))
fi

# ── Final outputs ──────────────────────────────────────────────────
emit_state_json "$SESSION_FILE"
emit_summary

exit 0
